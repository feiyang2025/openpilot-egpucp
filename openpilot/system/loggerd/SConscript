Import('env', 'arch', 'messaging', 'common', 'visionipc')

libs = [common, messaging, visionipc,
        'avformat', 'avcodec', 'swresample', 'avutil', 'x264',
        'pthread', 'z', 'm', 'zstd']
frameworks = []

src = ['logger.cc', 'zstd_writer.cc', 'video_writer.cc', 'encoder/encoder.cc', 'encoder/v4l_encoder.cc', 'encoder/cluster_h264_encoder.cc', 'encoder/jpeg_encoder.cc']
if arch != "larch64":
  src += ['encoder/ffmpeg_encoder.cc']
  if 'yuv' not in libs:
    libs += ['yuv']
  if arch == "Darwin":
    frameworks += ['VideoToolbox', 'CoreMedia', 'CoreFoundation', 'CoreVideo']

if arch == "aarch64":
  # Jetson NVENC 硬编 (NvMmlite): 类实现复用 Jetson 多媒体 API 样例源码,
  # 设备上编译; 仅 encoderd 主路启用, 开关在 encoderd.cc 的 JETSON_MAIN_ENCODER_NVENC。
  nvmmlite_classes = '/usr/src/jetson_multimedia_api/samples/common/classes'
  src += [
    'encoder/jetson_nvenc_encoder.cc',
    nvmmlite_classes + '/NvVideoEncoder.cpp',
    nvmmlite_classes + '/NvV4l2Element.cpp',
    nvmmlite_classes + '/NvV4l2ElementPlane.cpp',
    nvmmlite_classes + '/NvElement.cpp',
    nvmmlite_classes + '/NvElementProfiler.cpp',
    nvmmlite_classes + '/NvBuffer.cpp',
    nvmmlite_classes + '/NvLogging.cpp',
    # qcam VIC 缩放通路: NvBufSurf::NvAllocate / NvTransform (NvBufSurface 包装)
    nvmmlite_classes + '/NvBufSurface.cpp',
  ]
  env.Append(CPPPATH=['/usr/src/jetson_multimedia_api/include', '/usr/local/cuda/include'])
  env.Append(LIBPATH=['/usr/lib/aarch64-linux-gnu/nvidia'])
  libs += ['v4l2', 'nvbufsurface', 'nvbufsurftransform']
  # 当前启用 NVENC (回滚: 注释此行即恢复 FFV1 基线)
  env.Append(CPPDEFINES=['JETSON_MAIN_ENCODER_NVENC'])

if arch != "Darwin":
  libs += ['va', 'va-drm', 'drm']

if arch == "Darwin":
  # exclude v4l
  del src[src.index('encoder/v4l_encoder.cc')]
  del src[src.index('encoder/cluster_h264_encoder.cc')]

logger_lib = env.Library('logger', src)
libs.insert(0, logger_lib)

env.Program('loggerd', ['loggerd.cc'], LIBS=libs, FRAMEWORKS=frameworks)
env.Program('encoderd', ['encoderd.cc'], LIBS=libs + ["jpeg"], FRAMEWORKS=frameworks)
env.Program('bootlog.cc', LIBS=libs, FRAMEWORKS=frameworks)
if arch in ("aarch64", "larch64"):
  env.SharedLibrary(
    'cluster_h264_encoder_bridge',
    ['encoder/cluster_h264_encoder_bridge.cc', 'encoder/cluster_h264_encoder.cc'],
    LIBS=[common, messaging, visionipc, 'pthread', 'z', 'm', 'zstd'],
    FRAMEWORKS=frameworks,
  )
  env.SharedLibrary(
    'cluster_h264_decoder_bridge',
    ['decoder/cluster_h264_decoder_bridge.cc', 'decoder/cluster_h264_decoder.cc'],
    LIBS=[common, messaging, visionipc, 'pthread', 'z', 'm', 'zstd'],
    FRAMEWORKS=frameworks,
  )

if GetOption('extras'):
  if arch != "Darwin":
    env.Program('tests/test_cluster_poll_timeout', ['tests/test_cluster_poll_timeout.cc'], LIBS=['pthread'])
  env.Program('tests/test_logger', ['tests/test_runner.cc', 'tests/test_logger.cc', 'tests/test_zstd_writer.cc'], LIBS=libs)
